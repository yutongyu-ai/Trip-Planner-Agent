# Copy to .env and fill in real keys (.env is gitignored, never committed).

# OpenAI (LangGraph agent LLM, gpt-4o-mini)
OPENAI_API_KEY=

# Google Places API (New) -- https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# OpenWeatherMap -- https://openweathermap.org/api (free tier needs no card)
OPENWEATHER_API_KEY=

# OSRM routing service; defaults to the public demo server, no key needed
OSRM_BASE_URL=https://router.project-osrm.org
